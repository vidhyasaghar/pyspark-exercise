{
    "name": "Python 3",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
    "runArgs": ["--name","Python3.10Spark3.5.0"],
    "features": {
        "ghcr.io/devcontainers-extra/features/spark-sdkman:2": {
            "version": "3.5.0"
        },
        "ghcr.io/devcontainers-extra/features/actionlint:1": {},
        "ghcr.io/devcontainers-extra/features/pylint:2": {},
        "ghcr.io/hspaans/devcontainer-features/pytest:2.0.0": {}        
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "ms-python.pylint",
                "ms-python.mypy-type-checker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true
                },
                "black-formatter.args": ["--line-lenght", "100"],
                "pylint.enabled": true,
                "mypy-type-checker.enable": true,
                "python.analysis.typeCheckingMode": "basic",
                "python.analysis.extraPaths": ["src"]

            }
        }
    },
    "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && pip install -e ."
}